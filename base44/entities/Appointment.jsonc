{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string",
      "description": "Email of the patient"
    },
    "patient_name": {
      "type": "string",
      "description": "Name of the patient at booking time"
    },
    "doctor_email": {
      "type": "string",
      "description": "Email of the onboarded doctor or osm placeholder"
    },
    "doctor_name": {
      "type": "string"
    },
    "specialization": {
      "type": "string"
    },
    "appointment_type": {
      "type": "string",
      "enum": [
        "offline",
        "chat",
        "audio",
        "video"
      ],
      "description": "Type of consultation"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_slot": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "pending"
    },
    "token_number": {
      "type": "string",
      "description": "Unique queue token assigned when the doctor accepts (e.g. MT-001)"
    },
    "fee": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "description": "Reason for visit or consultation notes from the patient"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending_onboard",
        "onboarded",
        "confirmed",
        "paid"
      ],
      "default": "pending_onboard",
      "description": "Whether the requested provider has been onboarded and paid"
    },
    "osm_id": {
      "type": "string",
      "description": "OpenStreetMap node id of the requested provider"
    },
    "osm_lat": {
      "type": "number"
    },
    "osm_lng": {
      "type": "number"
    },
    "osm_name": {
      "type": "string"
    },
    "osm_address": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_id": {
      "type": "string",
      "description": "Stripe session/checkout id"
    },
    "provider_request_id": {
      "type": "string",
      "description": "Linked ProviderRequest record"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 2-hour pre-appointment reminder has been sent"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "patient_email",
    "doctor_email",
    "appointment_type",
    "date",
    "time_slot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "data.doctor_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "data.doctor_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "data.doctor_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}