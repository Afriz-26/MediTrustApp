{
  "name": "HealthTrackerSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the patient who purchased the tier"
    },
    "tier": {
      "type": "string",
      "enum": [
        "pro",
        "elite"
      ],
      "description": "Purchased tier"
    },
    "amount": {
      "type": "number",
      "description": "Amount paid in INR"
    },
    "payment_id": {
      "type": "string",
      "description": "Stripe session/checkout id"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ],
      "default": "pending"
    },
    "purchased_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "tier",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}