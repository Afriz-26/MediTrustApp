{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "provider_email": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "doctor",
        "pharmacy",
        "skincare_store"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "elite"
      ]
    },
    "amount": {
      "type": "number"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "payment_id": {
      "type": "string",
      "description": "Linked Payment record id"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "provider_email",
    "provider_type",
    "tier",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.provider_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.provider_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.provider_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}