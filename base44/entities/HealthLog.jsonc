{
  "name": "HealthLog",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "symptom",
        "medicine",
        "note",
        "visit_summary"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe"
      ],
      "description": "Only for symptom logs"
    },
    "medicine_name": {
      "type": "string"
    },
    "medicine_dose": {
      "type": "string"
    },
    "medicine_taken": {
      "type": "boolean",
      "default": false
    },
    "doctor_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "prescription",
        "lab_report",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "description": "Size of uploaded file in bytes (for storage metering)"
    },
    "reminder_time": {
      "type": "string"
    }
  },
  "required": [
    "patient_email",
    "log_type",
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}